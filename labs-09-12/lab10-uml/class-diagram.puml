@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam linetype ortho
class AnalysisService {
  - analyzer : SourceAnalyzer
  - strategy : ScenarioGenerationStrategy
  - repository : AnalysisRepository
  - observers : List<AnalysisObserver>
  + analyze(request) : AnalysisResult
  + setStrategy(strategy) : void
  + addObserver(observer) : void
}
interface SourceAnalyzer
class SimpleJavaAnalyzer
interface ScenarioGenerationStrategy <<Strategy>> {
  + generate(methods) : List<TestScenario>
  + name() : String
}
class BoundaryStrategy <<Strategy>>
class NegativeStrategy <<Strategy>>
class CombinedStrategy <<Strategy>>
interface AnalysisComponentFactory <<Factory>> {
  + createAnalyzer() : SourceAnalyzer
  + createStrategy() : ScenarioGenerationStrategy
  + createRepository() : AnalysisRepository
}
class DefaultAnalysisComponentFactory <<Factory>>
interface AnalysisObserver <<Observer>> {
  + onCompleted(result) : void
}
class ConsoleAnalysisObserver <<Observer>>
interface AnalysisRepository <<Repository>> {
  + save(result) : void
  + findById(id) : Optional
  + findAll() : List
}
class InMemoryAnalysisRepository <<Repository>>
class AnalysisRequest <<record>>
class AnalysisResult <<record>>
class SourceMethod <<record>>
class TestScenario <<record>>
SourceAnalyzer <|.. SimpleJavaAnalyzer
ScenarioGenerationStrategy <|.. BoundaryStrategy
ScenarioGenerationStrategy <|.. NegativeStrategy
ScenarioGenerationStrategy <|.. CombinedStrategy
CombinedStrategy o-- ScenarioGenerationStrategy
AnalysisComponentFactory <|.. DefaultAnalysisComponentFactory
AnalysisObserver <|.. ConsoleAnalysisObserver
AnalysisRepository <|.. InMemoryAnalysisRepository
AnalysisService --> SourceAnalyzer
AnalysisService --> ScenarioGenerationStrategy
AnalysisService --> AnalysisRepository
AnalysisService o-- AnalysisObserver
AnalysisService ..> AnalysisRequest
AnalysisService ..> AnalysisResult
AnalysisResult *-- SourceMethod
AnalysisResult *-- TestScenario
DefaultAnalysisComponentFactory ..> SimpleJavaAnalyzer : creates
DefaultAnalysisComponentFactory ..> CombinedStrategy : creates
DefaultAnalysisComponentFactory ..> InMemoryAnalysisRepository : creates
@enduml
