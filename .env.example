# Скопируйте этот файл в .env (в корне проекта), чтобы включить вызовы к
# нейросети. Это НЕОБЯЗАТЕЛЬНО: без .env (или с пустым LLM_API_KEY) агент
# полностью рабочий и использует собственный алгоритм. Нейросеть
# привлекается только для веток кода, которые алгоритм не смог покрыть, и
# её значения принимаются только если при запуске увеличивают покрытие.
#
# Подходит ЛЮБОЙ OpenAI-совместимый API (LLM_API_BASE_URL +
# /chat/completions). Никуда пересылать ключ не нужно - он используется
# только локально, внутри вашего docker-compose стека, .env не попадает
# в git (см. .gitignore).
#
# Примеры бесплатных провайдеров:
#
#   Groq (https://console.groq.com/keys):
#     LLM_API_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.1-8b-instant
#     LLM_API_KEY=gsk_...
#
#   OpenRouter (https://openrouter.ai/keys) - обратите внимание на
#   суффикс ":free" у модели, он обязателен для бесплатного использования:
#     LLM_API_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
#     LLM_API_KEY=sk-or-v1-...
#
# Платный OpenAI (значения по умолчанию, если .env не создан):
#     LLM_API_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini
#     LLM_API_KEY=sk-...

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1
