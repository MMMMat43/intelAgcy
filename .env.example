# Скопируйте этот файл в .env (в корне проекта) и заполните реальным ключом,
# чтобы включить настоящие вызовы к LLM при генерации тестов.
# Без файла .env (или с пустым LLM_API_KEY) агент работает только на
# эвристиках - это нормальный и полностью рабочий режим по умолчанию.

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1
